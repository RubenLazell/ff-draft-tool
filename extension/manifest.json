{
  "manifest_version": 3,
  "name": "FF Draft Tool — Live Draft Assistant",
  "version": "0.2.1",
  "description": "Shows your next-best available players by rank and position while drafting live on ESPN or Sleeper Fantasy Football.",
  "permissions": ["storage"],
  "host_permissions": ["https://oyfaaevlfhpklpqltbhr.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football*", "https://sleeper.com/*"],
      "js": ["config.js", "adapters/espn.js", "adapters/sleeper.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FF Draft Tool",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
