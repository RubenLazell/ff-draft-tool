# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# packaged Chrome extension build, regenerate with PowerShell Compress-Archive
/ff-draft-tool-extension.zip

# Chrome Web Store screenshots — contain personal info (email, league name)
/Screenshot*.png
/screenshot*.png
/store-screenshot-*.png
